# Copy to flixr.env; Compose reads it via env_file. Never commit real credentials.
FLIXR_FILMS_ROOT=/media/films
FLIXR_TV_ROOT=/media/tv
FLIXR_SCAN_ON_START=true
FLIXR_SCAN_WORKERS=4
# Optional offline mode. This does not delete a saved personal override.
# FLIXR_METADATA_ENABLED=false
# Optional first-start provisioning; existing accounts are never reset.
# FLIXR_OWNER_PASSWORD_FILE=/run/secrets/owner_password
# FLIXR_INITIAL_PROFILE=Home
# FLIXR_TMDB_TOKEN_FILE=/run/secrets/tmdb_token
# Optional playback limits; bytes are integers and times are Go durations.
# FLIXR_GENERATION_BYTES=268435456
# FLIXR_GLOBAL_BYTES=536870912
# FLIXR_MAX_GENERATIONS=2
# FLIXR_LEASE_TTL=45s
# FLIXR_HEARTBEAT_INTERVAL=15s
# FLIXR_SEGMENT_WINDOW=60s
# FLIXR_PROCESS_GRACE=2s
