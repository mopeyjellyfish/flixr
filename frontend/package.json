{
  "name": "flixr-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Flixr web interface",
  "scripts": {
    "test": "vitest run",
    "lint": "eslint src e2e *.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test:bundle": "node scripts/check-bundles.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "build:embed": "npm run build && node scripts/embed.mjs",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "dev": "vite --host 127.0.0.1 --port 19879 --strictPort"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.10",
    "hls.js": "^1.7.1",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "type": "module"
}
